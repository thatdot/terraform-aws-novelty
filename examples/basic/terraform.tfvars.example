# -----------------------------------------------------------------------------
# Example Configuration for Basic Deployment
# -----------------------------------------------------------------------------
# Copy this file to terraform.tfvars and customize for your environment.
# Lines starting with # are comments.
# -----------------------------------------------------------------------------

# AWS Configuration
aws_region = "us-west-2"

# Container Image (Required)
# You must provide your own ECR image URI
container_image = "<your-account-id>.dkr.ecr.<region>.amazonaws.com/thatdot/novelty:<tag>"

# Novelty License (Required)
# Store the key in AWS Secrets Manager first and pass the secret's ARN here:
#   aws secretsmanager create-secret --name novelty/license-key --secret-string "$NOVELTY_LICENSE_KEY"
license_key_secret_arn = ""                            # Required - ARN of the secret holding your license key
license_server_uri     = "https://license.thatdot.com" # License server URI
